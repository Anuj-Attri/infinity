# Copy to .env and fill in what you need. Never commit the real .env.

# --- Required --------------------------------------------------------------
# Every model call goes through this key. Without it, chat refuses.
OPENROUTER_API_KEY=

# Where your data is written (SQLite and files). Unset means the container's
# own disk, which a rebuild wipes. Point it at a volume you keep.
# DATA_DIR=/data

# --- Optional --------------------------------------------------------------
# Search by meaning over your vault and memories (Voyage voyage-4, 1024-dim).
# Without it, everything still works and is searchable by exact text. After
# setting it, POST /vault/reindex and POST /memory/reindex to embed what
# already exists.
# VOYAGE_API_KEY=

# Error reporting. Message bodies and document text are scrubbed before send.
# SENTRY_DSN=

# --- Running it for yourself on a server ------------------------------------
# With none of the access settings below, only requests from this machine are
# served. Everything else gets a 404.

# A shared key that opens the door. Present it once at /access#<key> and the
# browser keeps a cookie. It is a door, not an account: sign-in still applies.
# ACCESS_TOKEN=

# Required to finish first-run setup from anywhere but this machine. Without
# it, the first stranger to reach setup would own the instance.
# SETUP_TOKEN=

# Your real origin, comma-separated. Empty means same-origin only. Never "*".
# ALLOWED_ORIGINS=https://your-domain.example

# Set to 1 only when a proxy really is in front (Cloudflare, Railway, nginx).
# TRUST_PROXY_HEADERS=1

# --- Running it as a public website -----------------------------------------
# Visitors get a throwaway session with no sign-in. Each browser tab is its own
# account, and its notes, files, memories and chats are deleted when the tab
# closes, or after GUEST_IDLE_MINUTES without activity if the close is missed.
# Guests cannot change settings, keys or connectors for the instance.
#
# Every guest spends YOUR model credit. Put a hard credit limit on the
# OpenRouter key and set a spend cap before turning this on.
# GUEST_SESSIONS=1
# GUEST_IDLE_MINUTES=30
# GUEST_MAX_SESSIONS=200

# Open the door to anyone without guest mode. Only for an instance with
# nothing private in it. GUEST_SESSIONS=1 implies this.
# ALLOW_PUBLIC=1

# --- Development only -------------------------------------------------------
# Resolves every request to one fixed account with NO authentication. Never
# set this on anything reachable from a network.
# INFINITY_DEV_ACCOUNT=1
