# Copy to .env for local dev. NEVER commit the real .env.

# --- M0 -------------------------------------------------------------------
# Explicit CORS allowlist, comma-separated. Empty = same-origin only.
# NEVER set this to "*" once hosted.
ALLOWED_ORIGINS=http://localhost:5173

# Dev-only account so M0/M1 can be built before auth lands.
# MUST be unset (or not "1") in production — with it off, an unauthenticated
# request raises NotAuthenticated -> 401 instead of silently becoming "somebody".
MARK4_DEV_ACCOUNT=1

# --- M1: Supabase ---------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# ⚠ service_role BYPASSES RLS. Backend-only, never shipped to a client, and
# never assumed to be enforcing policies. See backend/app/retrieval.py.
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# --- M2: models -----------------------------------------------------------
# OPENROUTER_API_KEY=
# Zero-data-retention must be enforced at account AND request level.
# OPENROUTER_ZDR=1

# --- M6: billing (wired, charging OFF) ------------------------------------
# STRIPE_SECRET_KEY=
# AUTUMN_API_KEY=
# BILLING_ENABLED=0

# --- Ops ------------------------------------------------------------------
# Enable PII scrubbing BEFORE switching Sentry on.
# SENTRY_DSN=
