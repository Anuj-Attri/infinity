# Secrets — nothing in this block may ever be committed.
.env
.env.*
!.env.example
*.key
*.pem
*.jks
keystore.properties
vault/

# Local data / models
.data/
.run/
.ml/
*.db
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node / frontend
node_modules/
dist/
.vite/
*.local

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent and editor session scratch. These can hold personal context.
.claude/
.cursor/
*.scratchpad.md

# Working notes for contributors' tools. Never part of the product.
AGENTS.md
CLAUDE.md
PLAN*.md
NOTES.local.md

# e2e artifacts — screenshots and reports are per-run, not source
frontend/e2e/shots/

# Browser profiles. A Windows path that loses its backslashes turns into a
# literal "Users<name>AppData..." directory here, holding cookies and saved
# logins. Never commit one, whatever the leading path looks like.
Users*AppData*/
**/Users*AppData*/
*/User Data/
**/Default/Network/Cookies

# Internal/dev docs. Kept on disk for the people building this; not shipped to
# users. The public surface is README.md and nothing else.
docs/
*.local.md
PERSONA_ARCHIVE.local.md
scripts/dev-backend.sh

# Unused media, not part of the app.
frontend/src/assets/thumbsup_egg.mp4
