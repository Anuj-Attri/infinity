# Secrets — nothing in this block may ever be committed.
.env
.env.*
!.env.example
*.key
*.pem
*.jks
keystore.properties
vault/

# Local data / models
.data/
.run/
.ml/
*.db
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node / frontend
node_modules/
dist/
.vite/
*.local

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent + session scratch (Mark 3 lesson: these leak personal context)
.claude/
.cursor/
*.scratchpad.md

# The shared agent brief. Gitignored by owner decision: all agents work in this
# one workspace, and it should never enter history.
AGENTS.md
NOTES.local.md

# e2e artifacts — screenshots and reports are per-run, not source
frontend/e2e/shots/

# Browser profiles. A Playwright script with a Windows path lost its backslashes
# and created a literal "UsersuserAppData..." directory here, which then got
# committed — 998 files including Cookies and Login Data. Never again, whatever
# the leading path looks like.
Usersuser*/
**/UsersuserAppData*/
*/User Data/
**/Default/Network/Cookies
